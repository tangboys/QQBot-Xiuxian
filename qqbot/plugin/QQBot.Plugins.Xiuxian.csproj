<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>QQBot.Plugins.Xiuxian.Plugin</AssemblyName>
    <Version>1.0.0</Version>
    <QQBotRoot Condition="'$(QQBotRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../..'))</QQBotRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(QQBotRoot)/src/QQBot.Abstractions/QQBot.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
    <None Update="plugin-info.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
