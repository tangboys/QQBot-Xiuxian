+                        }
+                        content = preview.ToString();
+                    }
+                }
+                Record(messageId, group ? "group" : "private", peerId, content);
+            }
+            catch (Exception) { /* 成功发送不能因为监控字段异常触发业务重发。 */ }
+        }
+        return result;
+    }
