+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace QQBot.Adapter.OneBot11;
+
+/// <summary>扩展受控动作传输，保留原普通发送响应限制。</summary>
+public sealed partial class OneBotHttpClient
+{
+    /// <summary>沿用宿主凭据调用动作，限制解压后回执为 2 MiB、JSON 深度 32，不重试。</summary>
+    public async Task<JsonElement> CallAsync(string action, JsonElement parameters, CancellationToken cancellationToken = default)
+    {
+        if (string.IsNullOrEmpty(action) || action.Length > 64 || action.Any(c => !(c is >= 'a' and <= 'z' or '_')))
+            throw new ArgumentException("无效 OneBot 动作。", nameof(action));
+        using var budget = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        budget.CancelAfter(options.HttpTimeoutMs);
+        using var request = new HttpRequestMessage(HttpMethod.Post, new Uri(new Uri(options.HttpBaseUrl.TrimEnd('/') + "/"), action));
+        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", options.AccessToken);
+        request.Content = JsonContent.Create(parameters);
+        using var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, budget.Token);
+        response.EnsureSuccessStatusCode();
+        using var body = await ReadResponseAsync(response, budget.Token, 2 * 1024 * 1024, 32);
+        var root = body.RootElement;
+        if (root.ValueKind != JsonValueKind.Object) throw new OneBotApiException(action, null);
+        int? retcode = root.TryGetProperty("retcode", out var code) && code.ValueKind == JsonValueKind.Number && code.TryGetInt32(out var number) ? number : null;
+        if (retcode != 0 || !root.TryGetProperty("status", out var status) || status.ValueKind != JsonValueKind.String || status.GetString() != "ok")
+            throw new OneBotApiException(action, retcode);
+        return root.TryGetProperty("data", out var data) ? data.Clone() : JsonSerializer.SerializeToElement<object?>(null);
+    }
+}
