+using System.Globalization;
+using System.Text.Json;
+using QQBot.Abstractions;
+
+namespace QQBot.Core;
+
+/// <summary>提供插件后台动作的权限边界。</summary>
+public sealed partial class PluginRuntime
+{
+    private readonly object _actionChannelLock = new();
+    private ActionChannel? _actionChannel;
+
+    /// <summary>仅在有效回调内签发通道，缺少状态存储或动作传输时拒绝。</summary>
+    private IPluginActionChannel OpenActionChannel(CancellationToken invocation)
+    {
+        invocation.ThrowIfCancellationRequested();
+        _backgroundStopping.Token.ThrowIfCancellationRequested();
+        if (_states is null) throw new NotSupportedException("后台动作需要插件状态存储。");
+        lock (_actionChannelLock)
+        {
+            invocation.ThrowIfCancellationRequested();
+            _backgroundStopping.Token.ThrowIfCancellationRequested();
+            return _actionChannel ??= new ActionChannel(this, actionClient ?? sender as IOneBotActionClient
+                ?? throw new NotSupportedException("当前发送器不支持 OneBot 动作。"));
+        }
+    }
+
+    /// <summary>对后台动作实施白名单、目标检查、开关复核。</summary>
+    private sealed class ActionChannel(PluginRuntime owner, IOneBotActionClient inner) : IPluginActionChannel
+    {
+        private readonly SemaphoreSlim _gate = new(1, 1);
+        private readonly SemaphoreSlim _slots = new(8, 8);
+        /// <summary>在停止或隔离时取消后台工作。</summary>
+        public CancellationToken Stopping => owner._backgroundStopping.Token;
+        /// <summary>提供不可修改的真实管理员配置快照。</summary>
+        public IReadOnlyCollection<long> AdministratorIds { get; } = Array.AsReadOnly(owner._administrators.ToArray());
+
+        /// <summary>每次从数据库核对真实开关；停机与隔离取消所有动作。</summary>
+        public async Task EnsureActiveAsync(long? groupId = null, CancellationToken cancellationToken = default)
+        {
+            if (groupId is <= 0) throw new ArgumentOutOfRangeException(nameof(groupId));
+            using var linked = CancellationTokenSource.CreateLinkedTokenSource(Stopping, cancellationToken);
+            linked.Token.ThrowIfCancellationRequested();
+            if (!(await owner._states!.GetAsync(owner.Metadata.Id, groupId, linked.Token)).EffectiveEnabled)
+                throw new OperationCanceledException("插件全局或目标群已关闭。", linked.Token);
+            linked.Token.ThrowIfCancellationRequested();
+        }
+
+        /// <summary>串行动作并在发送前复核权限，不提供消息查询、撤回或管理动作。</summary>
+        public async Task<JsonElement> CallAsync(string action, JsonElement parameters, CancellationToken cancellationToken = default)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            Stopping.ThrowIfCancellationRequested();
+            // 每个运行实例最多保留八个进行中或排队动作，重复申请通道不能扩大额度。
+            if (!_slots.Wait(0, cancellationToken)) throw new InvalidOperationException("后台动作队列已满。");
+            try
+            {
+                using var linked = CancellationTokenSource.CreateLinkedTokenSource(Stopping, cancellationToken);
+                linked.CancelAfter(TimeSpan.FromSeconds(30));
+                var ct = linked.Token;
+                await _gate.WaitAsync(ct);
+                try
+                {
+                    if (parameters.ValueKind != JsonValueKind.Object || parameters.GetRawText().Length > 8 * 1024 * 1024)
+                        throw new ArgumentException("动作参数必须为有界 JSON 对象。");
+                    var allowed = action switch
+                    {
+                        "send_group_msg" => "group_id,message,auto_escape",
+                        "send_private_msg" => "user_id,message,auto_escape",
+                        "send_group_forward_msg" => "group_id,messages",
+                        "send_private_forward_msg" => "user_id,messages",
+                        "get_group_list" or "get_login_info" => "no_cache",
+                        "get_group_member_info" => "group_id,user_id,no_cache",
+                        "get_stranger_info" => "user_id,no_cache",
+                        _ => throw new NotSupportedException("插件动作不在允许清单中。")
+                    };
+                    var keys = allowed.Split(',');
+                    ValidateProperties(parameters, keys);
+                    foreach (var flag in new[] { "auto_escape", "no_cache" })
+                        if (parameters.TryGetProperty(flag, out var value) && value.ValueKind is not (JsonValueKind.True or JsonValueKind.False))
+                            throw new ArgumentException("动作布尔参数无效。");
+                    long? group = parameters.TryGetProperty("group_id", out _) ? ReadId(parameters, "group_id", true) : null;
+                    if (action.Contains("group", StringComparison.Ordinal) && action != "get_group_list" && group is null)
+                        throw new ArgumentException("群动作缺少目标群。");
+                    if (keys.Contains("user_id")) _ = ReadId(parameters, "user_id", true);
+                    if (action.StartsWith("send_", StringComparison.Ordinal))
+                    {
+                        var field = action.Contains("forward", StringComparison.Ordinal) ? "messages" : "message";
+                        if (!parameters.TryGetProperty(field, out var content) || content.ValueKind is not (JsonValueKind.Array or JsonValueKind.String))
+                            throw new ArgumentException("发送动作缺少消息内容。");
+                        var safe = parameters.EnumerateObject().ToDictionary(p => p.Name, p => (object)p.Value);
+                        safe[field] = NormalizeContent(content, field == "messages", 0);
+                        parameters = JsonSerializer.SerializeToElement(safe);
+                        if (parameters.GetRawText().Length > 8 * 1024 * 1024) throw new ArgumentException("规范化消息超出参数大小限制。");
+                    }
+                    await EnsureActiveAsync(group, ct);
+                    var result = await inner.CallAsync(action, parameters, ct);
+                    if (action == "get_group_list")
+                    {
+                        if (result.ValueKind != JsonValueKind.Array) throw new InvalidDataException("群列表回执无效。");
+                        var visible = new List<JsonElement>();
+                        foreach (var item in result.EnumerateArray())
+                            if ((await owner._states!.GetAsync(owner.Metadata.Id, ReadId(item, "group_id", true), ct)).EffectiveEnabled) visible.Add(item);
+                        await EnsureActiveAsync(null, ct);
+                        return JsonSerializer.SerializeToElement(visible);
+                    }
+                    return result;
+                }
+                finally { _gate.Release(); }
+            }
+            finally { _slots.Release(); }
+        }
+
+        /// <summary>限制消息段及字段，所有层级的字符串都转为文本段，禁止 CQ 指令、本地文件和已有消息引用。</summary>
+        private static object NormalizeContent(JsonElement content, bool nodes, int depth)
+        {
+            if (depth > 12) throw new ArgumentException("消息嵌套过深。");
+            if (content.ValueKind == JsonValueKind.String)
+            {
+                if (nodes) throw new ArgumentException("转发必须使用内联节点。");
+                return new[] { new { type = "text", data = new { text = content.GetString() } } };
+            }
+            if (content.ValueKind != JsonValueKind.Array) throw new ArgumentException("消息段格式无效。");
+            var result = new List<object>();
+            bool? nodeSegments = null;
+            foreach (var segment in content.EnumerateArray())
+            {
+                ValidateProperties(segment, "type", "data");
+                var type = segment.GetProperty("type").GetString();
+                var data = segment.GetProperty("data");
+                if (nodes && type != "node") throw new ArgumentException("转发必须使用内联节点。");
+                if (nodeSegments is { } previous && previous != (type == "node")) throw new ArgumentException("转发节点不能和普通消息段混用。");
+                nodeSegments = type == "node";
+                switch (type)
+                {
+                    case "text":
+                        ValidateProperties(data, "text");
+                        if (data.GetProperty("text").ValueKind != JsonValueKind.String) throw new ArgumentException("文本段格式无效。");
+                        break;
+                    case "at":
+                        ValidateProperties(data, "qq");
+                        var qq = data.GetProperty("qq");
+                        if (qq.ValueKind != JsonValueKind.String || qq.GetString() != "all") _ = ReadId(data, "qq", true);
+                        break;
+                    case "image":
+                        // 保留官方适配器随图片附带的标准选项，不接受其他媒体或路径字段。
+                        ValidateProperties(data, "file", "type", "cache", "proxy", "timeout");
+                        var file = data.GetProperty("file").GetString() ?? "";
+                        if (!file.StartsWith("base64://", StringComparison.Ordinal) &&
+                            !(Uri.TryCreate(file, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https"))
+                            throw new ArgumentException("图片必须为内存图片或 HTTP 地址。");
+                        break;
+                    case "node":
+                        ValidateProperties(data, "user_id", "uin", "nickname", "name", "content");
+                        var modernId = data.TryGetProperty("user_id", out _);
+                        var modernName = data.TryGetProperty("nickname", out _);
+                        if (modernId && data.TryGetProperty("uin", out _) || modernName && data.TryGetProperty("name", out _))
+                            throw new ArgumentException("转发节点身份字段重复。");
+                        var userId = ReadId(data, modernId ? "user_id" : "uin", true);
+                        var name = data.GetProperty(modernName ? "nickname" : "name");
+                        if (name.ValueKind != JsonValueKind.String || string.IsNullOrWhiteSpace(name.GetString()))
+                            throw new ArgumentException("转发节点昵称无效。");
+                        // 接受上游别名，统一按 OneBot 标准字段传给 NapCat。
+                        result.Add(new { type = "node", data = new { user_id = userId, nickname = name.GetString(),
+                            content = NormalizeContent(data.GetProperty("content"), false, depth + 1) } });
+                        continue;
+                    default: throw new ArgumentException("消息段类型不在允许清单中。");
+                }
+                result.Add(segment);
+            }
+            return result;
+        }
+
+        /// <summary>拒绝未知及重复字段，避免宿主验证的结构与协议端实际解析的结构不一致。</summary>
+        private static void ValidateProperties(JsonElement value, params string[] allowed)
+        {
+            if (value.ValueKind != JsonValueKind.Object) throw new ArgumentException("动作或消息段必须为 JSON 对象。");
+            var seen = new HashSet<string>(StringComparer.Ordinal);
+            foreach (var property in value.EnumerateObject())
+                if (!allowed.Contains(property.Name, StringComparer.Ordinal) || !seen.Add(property.Name))
+                    throw new ArgumentException("动作或消息段包含未允许或重复的字段。");
+        }
+
+        /// <summary>接受平台常见的数字或十进制字符串 ID，目标账号与群必须为正数。</summary>
+        private static long ReadId(JsonElement value, string name, bool positive)
+        {
+            if (!value.TryGetProperty(name, out var id) ||
+                !(id.ValueKind == JsonValueKind.Number ? id.TryGetInt64(out var number) : long.TryParse(id.ValueKind == JsonValueKind.String ? id.GetString() : null,
+                    NumberStyles.None, CultureInfo.InvariantCulture, out number)) ||
+                (positive && number <= 0)) throw new ArgumentException("动作目标 ID 无效。");
+            return number;
+        }
+    }
+}
